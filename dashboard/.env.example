# Without Supabase the dashboard runs in demo mode (in-memory data, no sign-in).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Jev (TypeSafe): post-call classification and decide_next_step
TYPESAFE_API_KEY=

# Public app URL (used for Slack links, invites and tool URLs)
APP_URL=http://localhost:3000

# ElevenLabs: your platform account (agents of clients without their own account)
ELEVENLABS_API_KEY=
# Secret of the shared post-call webhook (/api/webhooks/elevenlabs) in your account
ELEVENLABS_WEBHOOK_SECRET=
